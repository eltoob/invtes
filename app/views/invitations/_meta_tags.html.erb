<%# What iMessage, WhatsApp, Slack etc. show when the invite link is shared. %>
<% description = [ event_when(event), event.details ].compact_blank.join(". ").truncate(200) %>
<meta name="description" content="<%= description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= invitation_url(event.slug) %>">
<meta property="og:title" content="<%= event.name %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:image" content="<%= invitation_preview_url(event.slug, v: EventPreviewImage.new(event).version) %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="<%= EventPreviewImage::WIDTH %>">
<meta property="og:image:height" content="<%= EventPreviewImage::HEIGHT %>">
<meta property="og:image:alt" content="<%= event.name %>, <%= event_when(event) %>">
<meta name="twitter:card" content="summary_large_image">
